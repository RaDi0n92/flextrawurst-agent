[Unit]
Description=llama-server hauhaucs Hintergrund-Instanz (Batch-Generator/Takt/Reaktionen, kein Live-Chat)
After=network.target llama-hauhaucs.service
Wants=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/root/werkraum/tools/models/hauhaucs_q6
AllowedCPUs=8-13
ExecStart=/usr/local/bin/llama-server \
  --model /root/werkraum/tools/models/hauhaucs_q6/Qwen3.6-35B-A3B-Uncensored-HauhauCS-Aggressive-Q6_K_P.gguf \
  --alias hauhaucs-q6 \
  --ctx-size 66666 \
  --threads 6 \
  --host 127.0.0.1 \
  --port 11436 \
  --parallel 2 \
  --flash-attn on \
  --mlock \
  --jinja \
  --metrics \
  --cache-type-k q8_0 \
  --cache-type-v q8_0 \
  --cache-ram 12288 \
  --ctx-checkpoints 64 \
  --cpu-range 8-13 \
  --cpu-range-batch 8-13 \
  --cpu-strict 1
Restart=on-failure
RestartSec=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
