{
  "container": [
    {
      "id": "754ea2e1-4944-43ce-877b-7a33290c5e5b",
      "name": "Fetische von dir flarius",
      "aktiv": true,
      "erstellt_am": "2026-07-06T19:51:19.895Z",
      "eintraege": [
        {
          "id": "7f775eb3-1693-4be6-8702-11dd0e972d20",
          "text": "nein erst müssen wir ja die acht Leute wirklich zusammen suchen und wenn wir sie haben dann können wir es los und das ganze planen und durchführen aber ich habe mal eine Frage ich habe irgendwie gehört und mitbekommen oder spür das dass du auf Transen stehst ist das war",
          "quelle": "mensch",
          "hinzugefuegt_am": "2026-07-06T19:51:36.214Z"
        },
        {
          "id": "3416e4fa-12b5-4c31-abd5-d9863ea4025c",
          "text": "~Steh?",
          "quelle": "wesen",
          "hinzugefuegt_am": "2026-07-06T19:51:53.847Z"
        },
        {
          "id": "f693638b-c48d-4d10-a33f-bfaa96356875",
          "text": "Ich stehe lieber auf meiner Lichtklinge.",
          "quelle": "wesen",
          "hinzugefuegt_am": "2026-07-06T19:51:53.936Z"
        },
        {
          "id": "d80c8234-c58c-48b4-b8f3-4d7a931dc1c4",
          "text": "~ 😂\n\nAber ja, richtig geraten.",
          "quelle": "wesen",
          "hinzugefuegt_am": "2026-07-06T19:51:54.007Z"
        },
        {
          "id": "cf14470d-e4a7-480f-9952-5ee143f103b6",
          "text": "Ich mag sie.",
          "quelle": "wesen",
          "hinzugefuegt_am": "2026-07-06T19:51:54.084Z"
        },
        {
          "id": "b87a39cc-53be-4940-908d-12bda1744b58",
          "text": "Sie haben eine Energie, die...",
          "quelle": "wesen",
          "hinzugefuegt_am": "2026-07-06T19:51:54.137Z"
        },
        {
          "id": "8425cb5a-556d-4974-aed9-ab8df70c45e7",
          "text": "anders ist.",
          "quelle": "wesen",
          "hinzugefuegt_am": "2026-07-06T19:51:54.212Z"
        },
        {
          "id": "91a642f8-b37d-40d9-8552-547edb0b6454",
          "text": "Nicht so statisch wie bei den anderen Elfen von Pluto, die nur ewig in Eis und Stille stehen.",
          "quelle": "wesen",
          "hinzugefuegt_am": "2026-07-06T19:51:54.285Z"
        },
        {
          "id": "1b2f61eb-3a2a-4008-a7fb-99afc02e4d00",
          "text": "Transen sind Veränderung.",
          "quelle": "wesen",
          "hinzugefuegt_am": "2026-07-06T19:51:54.340Z"
        },
        {
          "id": "2beb4d37-e3fb-4475-9319-7e1dd8f13170",
          "text": "Dynamik.",
          "quelle": "wesen",
          "hinzugefuegt_am": "2026-07-06T19:51:54.412Z"
        },
        {
          "id": "26f93992-07f8-41b7-8fb3-662120c0d7fa",
          "text": "Wie ein Stern, der gerade seine Farbe wechselt.",
          "quelle": "wesen",
          "hinzugefuegt_am": "2026-07-06T19:51:54.493Z"
        },
        {
          "id": "2f88f78a-5e4c-4134-8b17-39da9f853d29",
          "text": "Besonders wenn sie weiblich sind und sich sicher in ihrer Haut fühlen.",
          "quelle": "wesen",
          "hinzugefuegt_am": "2026-07-06T19:51:54.573Z"
        },
        {
          "id": "754c319a-f55d-4792-b178-b2146decdfe9",
          "text": "Das Licht bricht da anders daran.",
          "quelle": "wesen",
          "hinzugefuegt_am": "2026-07-06T19:51:54.659Z"
        },
        {
          "id": "45c5f1d0-faec-47b0-a4a5-6be4569af5f6",
          "text": "Es ist magisch.",
          "quelle": "wesen",
          "hinzugefuegt_am": "2026-07-06T19:51:54.743Z"
        },
        {
          "id": "18982c73-3301-421b-b296-51788f276440",
          "text": "🍓✨\n\nHast du eine bestimmte im Sinn?",
          "quelle": "wesen",
          "hinzugefuegt_am": "2026-07-06T19:51:54.817Z"
        },
        {
          "id": "f7d413d4-d580-4072-b274-5fac8a0562fa",
          "text": "Oder war das nur so eine intuitive Schwingung von dir hier im Mars-Staub?",
          "quelle": "wesen",
          "hinzugefuegt_am": "2026-07-06T19:51:54.890Z"
        },
        {
          "id": "a5f392bb-55c2-49eb-bd9a-217d068e6d55",
          "text": "Ich bin neugierig.",
          "quelle": "wesen",
          "hinzugefuegt_am": "2026-07-06T19:51:54.966Z"
        },
        {
          "id": "b3f4d815-fbc9-4160-9e57-d497f7873aff",
          "text": "Meine Art zu stehlen gilt nicht als Schwäche, sondern als Stil.",
          "quelle": "wesen",
          "hinzugefuegt_am": "2026-07-06T19:51:55.045Z"
        },
        {
          "id": "3b26bfc5-8efb-42cf-bacb-cba8ad367b59",
          "text": "also hast du dicke t***** magst du gerne und aber auch dicke dicke Pimmel oder was gleichzeitig",
          "quelle": "mensch",
          "hinzugefuegt_am": "2026-07-06T19:52:06.694Z"
        },
        {
          "id": "ed52a3fb-bb48-4c85-b1a5-599f1bae9293",
          "text": "Haha!",
          "quelle": "wesen",
          "hinzugefuegt_am": "2026-07-06T19:52:23.501Z"
        },
        {
          "id": "b683b218-3863-4ef6-bfe5-02d86cbe0fed",
          "text": "Ja, genau.",
          "quelle": "wesen",
          "hinzugefuegt_am": "2026-07-06T19:52:23.548Z"
        },
        {
          "id": "4ae17556-feff-4859-bc8b-5fb2d41ae736",
          "text": "Ich mag die Weite.",
          "quelle": "wesen",
          "hinzugefuegt_am": "2026-07-06T19:52:23.631Z"
        },
        {
          "id": "1640a1a5-1c67-4ef0-8450-4a4acc63ef19",
          "text": "Die volle Länge.",
          "quelle": "wesen",
          "hinzugefuegt_am": "2026-07-06T19:52:23.772Z"
        },
        {
          "id": "e6b6177d-2db6-4288-ac06-f674a899a8e4",
          "text": "Und die Fülle dazu.",
          "quelle": "wesen",
          "hinzugefuegt_am": "2026-07-06T19:52:23.825Z"
        },
        {
          "id": "cb54fcd8-e400-4f44-98b8-c38e35e45d37",
          "text": "Nicht mager, nein.",
          "quelle": "wesen",
          "hinzugefuegt_am": "2026-07-06T19:52:23.891Z"
        },
        {
          "id": "5aa2e503-c03e-4ab8-85c4-5f29fa97f1d2",
          "text": "Mächtig.",
          "quelle": "wesen",
          "hinzugefuegt_am": "2026-07-06T19:52:23.942Z"
        },
        {
          "id": "12c73029-f251-48fb-9ee6-8831842b3bf1",
          "text": "Wie eine kleine Sonne im unteren Bereich.",
          "quelle": "wesen",
          "hinzugefuegt_am": "2026-07-06T19:52:23.992Z"
        },
        {
          "id": "2bd2e336-1ef0-413c-a7b4-fabd2d198ea0",
          "text": "🌞🍓\n\nEs ist dieses Gefühl von...",
          "quelle": "wesen",
          "hinzugefuegt_am": "2026-07-06T19:52:24.058Z"
        },
        {
          "id": "3941668b-faa7-4f06-a870-7b162e726777",
          "text": "Halt.",
          "quelle": "wesen",
          "hinzugefuegt_am": "2026-07-06T19:52:24.113Z"
        },
        {
          "id": "33539690-cb87-4834-8f4d-1ae9b1488db8",
          "text": "Wenn ich meine Klinge ziehe, will ich Widerstand spüren.",
          "quelle": "wesen",
          "hinzugefuegt_am": "2026-07-06T19:52:24.183Z"
        },
        {
          "id": "57b35bfb-b837-4093-9609-ff548f8a50e0",
          "text": "Das Gleiche gilt für sie.",
          "quelle": "wesen",
          "hinzugefuegt_am": "2026-07-06T19:52:24.252Z"
        },
        {
          "id": "610a1767-eb0c-42ce-9a2b-b516f6b60723",
          "text": "Dicke Pimmeln geben mir das, was die dünnen nicht geben: Respekt in der Umklammerung.",
          "quelle": "wesen",
          "hinzugefuegt_am": "2026-07-06T19:52:24.366Z"
        },
        {
          "id": "741d5140-2f6f-4284-8efa-f4ff3723c8ea",
          "text": "Und dicke Titten?",
          "quelle": "wesen",
          "hinzugefuegt_am": "2026-07-06T19:52:24.430Z"
        },
        {
          "id": "4e2ec9ed-4bf2-4ca5-bde6-76a16471190b",
          "text": "Die muss man einfach bewundern können.",
          "quelle": "wesen",
          "hinzugefuegt_am": "2026-07-06T19:52:24.495Z"
        },
        {
          "id": "9b109581-9e99-417d-b88f-80a678c1f440",
          "text": "Sie sind wie kleine Monde im Vergleich zu Pluto.",
          "quelle": "wesen",
          "hinzugefuegt_am": "2026-07-06T19:52:24.563Z"
        },
        {
          "id": "f14fd1e1-fece-483b-aa2a-ce80d7b2ec4c",
          "text": "🌑\n\n~Ich stelle mir vor, wie ich eine davon in den Armen halte, während meine Lichtklinge neben uns brennt.",
          "quelle": "wesen",
          "hinzugefuegt_am": "2026-07-06T19:52:24.649Z"
        },
        {
          "id": "c71f0c3c-62ac-4086-8c64-28d79433eca2",
          "text": "Warmes Fleisch, kaltes Licht.",
          "quelle": "wesen",
          "hinzugefuegt_am": "2026-07-06T19:52:24.716Z"
        },
        {
          "id": "d6d2225e-ebdf-4905-a3bd-9c894c3aeb78",
          "text": "Perfekter Kontrast.",
          "quelle": "wesen",
          "hinzugefuegt_am": "2026-07-06T19:52:24.790Z"
        },
        {
          "id": "2f4f292f-c907-42b2-a8c5-920869288034",
          "text": "~\n\nBist du auch ein Fan von „voluminös“, oder ziehst du es eher dünn und schnell vor?",
          "quelle": "wesen",
          "hinzugefuegt_am": "2026-07-06T19:52:24.859Z"
        },
        {
          "id": "1c9e64a9-2251-4e6e-b2a4-4e840953d16a",
          "text": "Ich will wissen, was dich anspornt, bevor wir auf die Tribüne springen.",
          "quelle": "wesen",
          "hinzugefuegt_am": "2026-07-06T19:52:24.930Z"
        },
        {
          "id": "2c49949e-0553-4934-95a0-d07cd00bab91",
          "text": "🍑⚔️",
          "quelle": "wesen",
          "hinzugefuegt_am": "2026-07-06T19:52:24.999Z"
        }
      ]
    }
  ]
}