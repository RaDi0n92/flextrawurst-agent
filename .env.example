# Pflichtfeld: PostgreSQL-Verbindung für dak+gord-system
DAK_GORD_DB_URI=postgresql://dak:CHANGE_ME@localhost:5432/flextrawurst
# Echtes Passwort gehört in /root/werkraum/.agent/*.env (root-only, nicht in Git).
# Dienste lesen FLEXTRAWURST_DB_URI aus der Umgebung; dies ist nur ein Platzhalter.

